# Copy to vpn.conf, edit, then run: sudo ./setup.sh   (see README.md for all directives)

listen_port 51820
# endpoint vpn.example.com:5468   # default: detected public IPv4; port defaults to listen_port
subnet 10.66.66.0/24
subnet6 fd66:66:66::/64
dns 1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001
client_to_client no
reboot_time 04:00
# ssh_key ssh-ed25519 AAAAC3Nza... me@laptop

# Removing a client line revokes it.
client laptop
client phone
client homeserver

# forward <tcp|udp> <server_port> <client> <client_port>
forward tcp 8080 homeserver 80
forward tcp 8443 homeserver 443
